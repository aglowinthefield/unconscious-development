#!/usr/bin/env bash
# The Unconscious Development CLI. `unconscious help` lists every command; the list and each
# command's help live in src/help.ts. Commands that set up the harness, run launchd or start a
# headless agent are below; the rest are in src/cli.ts.
set -euo pipefail

ud_root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
agents_dir="${PI_AGENTS_DIR:-$HOME/.pi/agent/agents}/unconscious"
skills_dir="${UD_SKILLS_DIR:-$HOME/.agents/skills}"
prompts_dir="${PI_PROMPTS_DIR:-$HOME/.pi/agent/prompts}"
pi_settings="${PI_SETTINGS:-$HOME/.pi/agent/settings.json}"
bili_config="${BILI_CONFIG:-$HOME/.config/billion-context/billion-context.json}"
claude_agents="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}"
claude_skills="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
claude_mark="<!-- written by unconscious enable --harness claude; disable removes it -->"

json_set() { # file, python statement on dict d
  python3 - "$1" "$2" <<'PY'
import json, os, sys
path, stmt = sys.argv[1], sys.argv[2]
d = json.load(open(path)) if os.path.exists(path) else {}
exec(stmt)
json.dump(d, open(path, "w"), indent=2)
open(path, "a").write("\n")
PY
}

enable() {
  mkdir -p "$agents_dir"
  for f in "$ud_root"/docs/roles/*.md; do
    grep -q '^name: ' "$f" || continue  # role files only, not Roles.md
    ln -sfn "$f" "$agents_dir/$(basename "$f")"
  done
  for s in "$ud_root"/skills/*/; do
    s="${s%/}"; dest="$skills_dir/$(basename "$s")"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then echo "warning: $dest exists and isn't ours; skipped" >&2; continue; fi
    ln -sfn "$s" "$dest"
  done
  mkdir -p "$prompts_dir"
  for p in "$ud_root"/prompts/*.md; do
    dest="$prompts_dir/$(basename "$p")"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then echo "warning: $dest exists and isn't ours; skipped" >&2; continue; fi
    ln -sfn "$p" "$dest"
  done
  json_set "$pi_settings" 'd.setdefault("subagents", {})["disableBuiltins"] = True'
  json_set "$bili_config" 'd.setdefault("pi", {})["subagents"] = False'
  grep -q 'pi-subagents' "$pi_settings" || echo "warning: pi-subagents isn't in $pi_settings packages; the roles have no harness to run them" >&2
  status
}

disable() {
  rm -rf "$agents_dir"
  for s in "$ud_root"/skills/*/; do
    dest="$skills_dir/$(basename "${s%/}")"
    [ -L "$dest" ] && [ "$(readlink "$dest")" = "${s%/}" ] && rm "$dest"
  done
  for p in "$ud_root"/prompts/*.md; do
    dest="$prompts_dir/$(basename "$p")"
    [ -L "$dest" ] && [ "$(readlink "$dest")" = "$p" ] && rm "$dest"
  done
  json_set "$pi_settings" '
s = d.get("subagents", {}); s.pop("disableBuiltins", None)
if not s: d.pop("subagents", None)'
  json_set "$bili_config" '
p = d.get("pi", {}); p.pop("subagents", None)
if not p: d.pop("pi", None)'
  status
}

# Claude Code reads subagents from Markdown files with nearly the same frontmatter, so each role is
# rewritten rather than linked: tool names differ, and pi-only keys go. The Ruler and Creator keep
# every tool, since they run as the main agent (`claude --agent ruler`) and send out other roles.
enable_claude() {
  mkdir -p "$claude_agents" "$claude_skills"
  python3 - "$ud_root/docs/roles" "$claude_agents" "$claude_mark" <<'PY'
import os, re, sys
roles, out, mark = sys.argv[1:]
names = {"read": "Read", "grep": "Grep", "find": "Glob", "ls": "Glob", "bash": "Bash", "edit": "Edit", "write": "Write"}
for f in sorted(os.listdir(roles)):
    text = open(os.path.join(roles, f)).read()
    m = re.match(r"---\n(.*?)\n---\n(.*)", text, re.S)
    if not m or not re.search(r"^name: ", m.group(1), re.M): continue
    fm = dict(l.split(": ", 1) for l in m.group(1).splitlines() if ": " in l)
    lines = [f"name: {fm['name']}", f"description: {fm['description']}"]
    tools = [t.strip() for t in fm.get("tools", "").split(",") if t.strip()]
    if fm["name"] not in ("ruler", "creator") and tools:
        lines.append("tools: " + ", ".join(dict.fromkeys(names.get(t, t) for t in tools)))
    lines.append(f"model: {fm.get('model', 'inherit')}")
    dest = os.path.join(out, f"{fm['name']}.md")
    if os.path.exists(dest) and mark not in open(dest).read():
        print(f"warning: {dest} exists and isn't ours; skipped", file=sys.stderr); continue
    open(dest, "w").write("---\n" + "\n".join(lines) + "\n---\n\n" + mark + "\n\n" + m.group(2).lstrip())
PY
  for s in "$ud_root"/skills/*/; do
    s="${s%/}"; dest="$claude_skills/$(basename "$s")"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then echo "warning: $dest exists and isn't ours; skipped" >&2; continue; fi
    ln -sfn "$s" "$dest"
  done
  status
}

disable_claude() {
  for f in "$claude_agents"/*.md; do [ -f "$f" ] && grep -qF "$claude_mark" "$f" && rm "$f"; done
  for s in "$ud_root"/skills/*/; do
    dest="$claude_skills/$(basename "${s%/}")"
    [ -L "$dest" ] && [ "$(readlink "$dest")" = "${s%/}" ] && rm "$dest"
  done
  status
}

status() { node --disable-warning=ExperimentalWarning "$ud_root/src/cli.ts" status; }

# Run status-page every 15 minutes and questions every 2 (both also at login), and propose daily at 07:00, as launchd
# agents. launchd never starts a job while its last run is still going. The agent keeps the PATH and
# Now folder of the shell that turned it on, so gh, git and node resolve the same way.
plist="$HOME/Library/LaunchAgents/dev.unconscious.status-page.plist"
propose_plist="$HOME/Library/LaunchAgents/dev.unconscious.propose.plist"
questions_plist="$HOME/Library/LaunchAgents/dev.unconscious.questions.plist"

# The Magician, headless: one pi run with the propose skill over every project page.
propose() {
  echo "== $(date -u +%FT%TZ) propose"
  "$ud_root/bin/unconscious" status-page || true
  local prompt="Use the propose skill headless: write Proposed next on every project page in ${UD_NOW_DIR:-the Now folder}. Today is $(date +%F)."
  if [ "${UD_HARNESS:-pi}" = claude ]; then
    # The Now folder sits outside any repo, so Claude needs it named to edit there.
    claude -p --add-dir "${UD_NOW_DIR:-$(node --disable-warning=ExperimentalWarning -e 'import("'"$ud_root"'/src/status.ts").then(m => console.log(m.nowDir()))')}" \
      --allowedTools "Read Grep Glob Bash Edit Write Skill" "$prompt"
  else
    pi -p --no-session --no-skills --skill "$ud_root/skills/propose" --tools read,bash,edit,write "$prompt"
  fi
  "$ud_root/bin/unconscious" status-page
}
# Draft a small issue's criteria headless: the Ruler, with the spec skill, writes them into the
# issue body and asks for ready-for-agent, or says the issue needs a spec session.
draft() {
  [ -n "${1:-}" ] || { echo "usage: unconscious draft <issue>" >&2; exit 2; }
  local prompt="Headless, for issue $1 in this repo. Read it with gh. If it's trivial, follow the spec skill's trivial tier: write its criteria into the body, check them, and comment asking for ready-for-agent. If it needs the designed tier, comment one line saying why and that it needs a spec session, and stop. Change no files and open no PRs."
  if [ "${UD_HARNESS:-pi}" = claude ]; then
    claude -p --agent ruler --allowedTools "Read Grep Glob Bash Skill" "$prompt"
    return
  fi
  local role; role="$(mktemp)"; trap 'rm -f "$role"' RETURN
  awk 'f>=2; /^---$/{f++}' "$ud_root/docs/roles/ruler.md" > "$role"
  pi -p --no-session --no-skills --skill "$ud_root/skills/spec" --append-system-prompt "$role" --tools read,grep,find,ls,bash "$prompt"
}

# Run the Shadow on a PR that already exists, as a first try of UD with no setup: criteria from the
# PR or its linked issues, or, when nobody wrote any, the ones the PR claims, marked as derived.
# Reads only; --comment posts the verdicts on the PR.
review() {
  local pr="" comment=""
  for a in "$@"; do case "$a" in --comment) comment=1 ;; *) pr="$a" ;; esac; done
  [ -n "$pr" ] || { echo "usage: unconscious review <pr> [--comment]" >&2; exit 2; }
  local meta base issues context wt out
  meta="$(gh pr view "$pr" --json number,title,body,baseRefName,closingIssuesReferences)"
  base="$(jq -r .baseRefName <<<"$meta")"
  pr="$(jq -r .number <<<"$meta")"
  context="PR #$pr: $(jq -r .title <<<"$meta")"$'\n\n'"$(jq -r '.body // ""' <<<"$meta")"
  for i in $(jq -r '.closingIssuesReferences[].number' <<<"$meta") $(jq -r '.body // ""' <<<"$meta" | grep -oiE 'refs:? #[0-9]+' | grep -oE '[0-9]+'); do
    context+=$'\n\n'"Issue #$i: $(gh issue view "$i" --json title,body --jq '.title + "\n\n" + .body')"
  done
  wt="$(mktemp -d)/pr-$pr"
  git fetch -q origin "$base"
  git fetch -q origin "pull/$pr/head" # last, so FETCH_HEAD is the PR's head
  git worktree add -q --detach "$wt" FETCH_HEAD
  trap "git worktree remove --force '$wt' 2>/dev/null || true" EXIT
  local prompt="Review PR #$pr. The change is \`git diff origin/$base...HEAD\` in this checkout.

Criteria: use the \`## Acceptance criteria\` from the PR or issues below. If there are none, write the criteria the PR claims to meet, three to six, as AC1, AC2, ..., say they were derived because nobody wrote any, then judge them.

$context"
  if [ "${UD_HARNESS:-pi}" = claude ]; then
    out="$(cd "$wt" && claude -p --agent shadow "$prompt")"
  else
    local role; role="$(mktemp)"
    awk 'f>=2; /^---$/{f++}' "$ud_root/docs/roles/shadow.md" > "$role"
    out="$(cd "$wt" && pi -p --no-session --no-skills --append-system-prompt "$role" --tools read,grep,find,ls,bash "$prompt")"
    rm -f "$role"
  fi
  printf '%s\n' "$out"
  [ -n "$comment" ] && gh pr comment "$pr" --body "$out"$'\n\n'"<sub>Shadow review by Unconscious Development.</sub>" >/dev/null && echo "posted on #$pr"
  return 0
}

# On Linux the same three jobs are systemd user timers. Persistent=true runs a missed propose
# once the host is back, and a failed propose retries every 30 minutes, up to 6 times a day.
# Needs lingering (`loginctl enable-linger`) to run while nobody is logged in.
systemd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
schedule_systemd() {
  local dir="$1" name
  mkdir -p "$systemd_dir"
  for name in status-page questions propose; do
    local limit="" retry=""
    if [ "$name" = propose ]; then
      limit=$'StartLimitIntervalSec=1d\nStartLimitBurst=6'
      retry=$'Restart=on-failure\nRestartSec=30min'
    fi
    cat > "$systemd_dir/unconscious-$name.service" <<UNIT
[Unit]
Description=Unconscious Development: $name
$limit

[Service]
Type=oneshot
ExecStart=$ud_root/bin/unconscious $name
Environment="PATH=$PATH"
Environment="UD_NOW_DIR=$dir"
Environment="UD_HARNESS=${UD_HARNESS:-pi}"
$retry
UNIT
  done
  cat > "$systemd_dir/unconscious-status-page.timer" <<UNIT
[Unit]
Description=Unconscious Development: status-page every 15 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=900

[Install]
WantedBy=timers.target
UNIT
  cat > "$systemd_dir/unconscious-questions.timer" <<UNIT
[Unit]
Description=Unconscious Development: questions every ${UD_QUESTIONS_INTERVAL:-120} seconds

[Timer]
OnBootSec=1min
OnUnitActiveSec=${UD_QUESTIONS_INTERVAL:-120}

[Install]
WantedBy=timers.target
UNIT
  cat > "$systemd_dir/unconscious-propose.timer" <<UNIT
[Unit]
Description=Unconscious Development: propose daily

[Timer]
OnCalendar=*-*-* $(printf %02d "${UD_PROPOSE_HOUR:-7}"):00:00
Persistent=true

[Install]
WantedBy=timers.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now unconscious-status-page.timer unconscious-questions.timer unconscious-propose.timer >/dev/null
  echo "status-page runs every 15 minutes into $dir; log: journalctl --user -u unconscious-status-page"
  echo "questions runs every ${UD_QUESTIONS_INTERVAL:-120} seconds; log: journalctl --user -u unconscious-questions"
  echo "propose runs daily at ${UD_PROPOSE_HOUR:-7}:00, and after the host was down then; log: journalctl --user -u unconscious-propose"
}
schedule_systemd_off() {
  local name
  for name in status-page questions propose; do
    systemctl --user disable --now "unconscious-$name.timer" >/dev/null 2>&1 || true
    rm -f "$systemd_dir/unconscious-$name.timer" "$systemd_dir/unconscious-$name.service"
  done
  systemctl --user daemon-reload
}

schedule() {
  case "${1:-}" in
    on)
      local dir="${UD_NOW_DIR:-}"
      [ -n "$dir" ] || dir="$(node --disable-warning=ExperimentalWarning -e 'import("'"$ud_root"'/src/status.ts").then(m => console.log(m.nowDir()))')"
      if [ "$(uname)" = Linux ]; then schedule_systemd "$dir"; return; fi
      cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.unconscious.status-page</string>
  <key>ProgramArguments</key>
  <array><string>$ud_root/bin/unconscious</string><string>status-page</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PATH</string>
    <key>UD_NOW_DIR</key><string>$dir</string>
    <key>UD_HARNESS</key><string>${UD_HARNESS:-pi}</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/unconscious-status-page.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/unconscious-status-page.log</string>
</dict>
</plist>
PLIST
      cat > "$questions_plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.unconscious.questions</string>
  <key>ProgramArguments</key>
  <array><string>$ud_root/bin/unconscious</string><string>questions</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PATH</string>
    <key>UD_NOW_DIR</key><string>$dir</string>
    <key>UD_HARNESS</key><string>${UD_HARNESS:-pi}</string>
  </dict>
  <key>StartInterval</key><integer>${UD_QUESTIONS_INTERVAL:-120}</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/unconscious-questions.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/unconscious-questions.log</string>
</dict>
</plist>
PLIST
      cat > "$propose_plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.unconscious.propose</string>
  <key>ProgramArguments</key>
  <array><string>$ud_root/bin/unconscious</string><string>propose</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PATH</string>
    <key>UD_NOW_DIR</key><string>$dir</string>
    <key>UD_HARNESS</key><string>${UD_HARNESS:-pi}</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>${UD_PROPOSE_HOUR:-7}</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/unconscious-propose.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/unconscious-propose.log</string>
</dict>
</plist>
PLIST
      for p in "$plist" "$questions_plist" "$propose_plist"; do
        launchctl bootout "gui/$(id -u)" "$p" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$p"
      done
      echo "status-page runs every 15 minutes into $dir; log: ~/Library/Logs/unconscious-status-page.log"
      echo "questions runs every ${UD_QUESTIONS_INTERVAL:-120} seconds; log: ~/Library/Logs/unconscious-questions.log"
      echo "propose runs daily at ${UD_PROPOSE_HOUR:-7}:00; log: ~/Library/Logs/unconscious-propose.log" ;;
    off)
      if [ "$(uname)" = Linux ]; then schedule_systemd_off; echo "schedule off"; return; fi
      for p in "$plist" "$questions_plist" "$propose_plist"; do launchctl bootout "gui/$(id -u)" "$p" 2>/dev/null || true; rm -f "$p"; done
      echo "schedule off" ;;
    *) status ;;
  esac
}

cli() { exec node --disable-warning=ExperimentalWarning "$ud_root/src/cli.ts" "$@"; }

# Help: `unconscious`, `unconscious help [cmd]`, and `-h`/`--help` after any command.
case "${1:-}" in ""|help|-h|--help) shift || true; cli help "$@" ;; esac
for a in "${@:2}"; do case "$a" in -h|--help) cli help "$1" ;; esac; done

harness=pi
[ "${1:-}" != review ] && [ "${2:-}" = "--harness" ] && harness="${3:-}"
case "$harness" in pi|claude) ;; *) echo "unknown harness \"$harness\"; use pi or claude" >&2; exit 2 ;; esac

case "$1" in
  enable) if [ "$harness" = claude ]; then enable_claude; else enable; fi ;;
  disable) if [ "$harness" = claude ]; then disable_claude; else disable; fi ;;
  schedule) schedule "${2:-}" ;;
  propose) propose ;;
  draft) draft "${2:-}" ;;
  review) shift; review "$@" ;;
  *) cli "$@" ;; # src/cli.ts runs its commands, and says "did you mean" for unknown ones
esac
